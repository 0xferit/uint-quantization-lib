{
  "branches": [
    "main"
  ],
  "plugins": [
    [
      "@semantic-release/exec",
      {
        "analyzeCommitsCmd": "printf '%s\\n' \"$RELEASE_BUMP\"",
        "prepareCmd": "python3 scripts/prepare-release.py ${nextRelease.version}",
        "publishCmd": "printf 'tag=%s\\n' '${nextRelease.gitTag}' >> \"$GITHUB_OUTPUT\""
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ],
    "./scripts/commit-release.mjs"
  ]
}
